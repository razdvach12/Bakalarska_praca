# Server
PORT=3000

# Standard OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# Optional: custom OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1


# Standard Gemini API
# Google Gemini
# Pozor: kod vie vytvorit google/gemini model, ale env premennu cita priamo AI SDK.
# GOOGLE_GENERATIVE_AI_API_KEY=your_google_gemini_api_key_here



# ALTERNATIVES:


# Azure / corporate OpenAI-compatible setup
# Pouzi iba ak volas model cez Azure OpenAI alebo firemny proxy endpoint.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# AZURE_OPENAI_API_VERSION=2024-02-15-preview
# AZURE_OPENAI_API_KEY=your_azure_openai_key_here

# Alternative non-Azure names supported by the code
# OPENAI_ENDPOINT=https://your-endpoint.example.com
# OPENAI_DEPLOYMENT=your-deployment-name
# OPENAI_DEPLOYMENT_ID=your-deployment-id
# OPENAI_API_VERSION=2024-02-15-preview

